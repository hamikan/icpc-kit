{
  "configurations": [
    {
      "name": "Mac",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/ac-library"
      ],
      "defines": [
        "LOCAL"
      ],
      "macFrameworkPath": [
        "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
      ],
      "compilerPath": "/opt/homebrew/bin/g++",
      "cStandard": "c17",
      "cppStandard": "gnu++20",
      "intelliSenseMode": "macos-gcc-arm64"
    }
  ],
  "version": 4
}