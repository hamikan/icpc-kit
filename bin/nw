#!/usr/bin/env bash
set -euo pipefail

if [ -n "${ICPC_KIT:-}" ]; then
  ROOT="$ICPC_KIT"
else
  ROOT="$(CDPATH= cd -P "$(dirname "$0")/.." && pwd)"
fi

template_id="${1:-1}"
case "$template_id" in
  1|2|3) ;;
  *) template_id="1" ;;
esac

if [ ! -d "$ROOT/template/$template_id" ]; then
  template_id="1"
fi

if [ ! -d "$ROOT/template/common/test" ] || [ ! -d "$ROOT/template/common/randomTest" ]; then
  echo "nw: template/common is missing" >&2
  exit 1
fi

max_work=0
for path in "$ROOT"/work*; do
  [ -d "$path" ] || continue
  name="$(basename "$path")"
  case "$name" in
    work*[!0-9]*|work) continue ;;
    work*)
      number="${name#work}"
      if [ "$number" -gt "$max_work" ]; then
        max_work="$number"
      fi
      ;;
  esac
done

next_work=$((max_work + 1))
work_dir="$ROOT/work$next_work"

if [ -e "$work_dir" ]; then
  echo "nw: $work_dir already exists" >&2
  exit 1
fi

mkdir -p "$work_dir"

for problem in A B C D E F G H I; do
  problem_dir="$work_dir/$problem"
  mkdir -p "$problem_dir"
  cp "$ROOT/template/$template_id/main.cpp" "$problem_dir/main.cpp"
  cp "$ROOT/template/$template_id/main.py" "$problem_dir/main.py"
  cp -R "$ROOT/template/common/test" "$problem_dir/test"
  cp -R "$ROOT/template/common/randomTest" "$problem_dir/randomTest"
done

echo "created $work_dir using template/$template_id"
